{
  "name": "QuoteLatest",
  "type": "object",
  "properties": {
    "instrument_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "last_price": {
      "type": "number"
    },
    "previous_close": {
      "type": "number"
    },
    "change_value": {
      "type": "number"
    },
    "change_percent": {
      "type": "number"
    },
    "open": {
      "type": "number"
    },
    "high": {
      "type": "number"
    },
    "low": {
      "type": "number"
    },
    "volume": {
      "type": "number"
    },
    "trade_count": {
      "type": "number"
    },
    "week52_high": {
      "type": "number"
    },
    "week52_low": {
      "type": "number"
    },
    "avg_volume": {
      "type": "number"
    },
    "traded_value": {
      "type": "number"
    },
    "market_cap": {
      "type": "number"
    },
    "source_id": {
      "type": "string"
    },
    "source_time": {
      "type": "string",
      "format": "date-time"
    },
    "received_time": {
      "type": "string",
      "format": "date-time"
    },
    "delay_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "license_status": {
      "type": "string",
      "enum": ["pending", "approved", "suspended", "expired"]
    },
    "quote_time": {
      "type": "string",
      "format": "date-time"
    },
    "quality_status": {
      "type": "string",
      "enum": [
        "verified",
        "stale",
        "quarantined"
      ]
    }
  },
  "required": [
    "instrument_id",
    "symbol",
    "last_price",
    "source_id",
    "quote_time",
    "quality_status"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
