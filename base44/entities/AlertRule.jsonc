{
  "name": "AlertRule",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "instrument_id": {
      "type": "string"
    },
    "market_code": { "type": "string" },
    "symbol": {
      "type": "string"
    },
    "interval": {
      "type": "string",
      "enum": ["15m", "1h", "2h", "3h", "4h", "1d", "1wk", "1mo"]
    },
    "indicator_key": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "crosses_above",
        "crosses_below",
        "enters_zone",
        "exits_zone",
        "crosses_drawing",
        "crosses_drawing_above",
        "crosses_drawing_below"
      ]
    },
    "threshold": {
      "type": "number"
    },
    "zone_key": {
      "type": "string"
    },
    "drawing_id": {
      "type": "string"
    },
    "drawing_type": {
      "type": "string"
    },
    "drawing_points": {
      "type": "array",
      "items": { "type": "object" }
    },
    "frequency": {
      "type": "string",
      "enum": [
        "once",
        "repeat"
      ]
    },
    "cooldown_minutes": {
      "type": "integer",
      "minimum": 15
    },
    "enabled": {
      "type": "boolean"
    },
    "last_observed_price": {
      "type": "number"
    },
    "last_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_evaluation_bucket": {
      "type": "string"
    },
    "last_triggered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "customer_id",
    "instrument_id",
    "symbol",
    "interval",
    "condition",
    "frequency",
    "cooldown_minutes",
    "enabled"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
