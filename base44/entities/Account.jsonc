{
  "type": "object",
  "name": "Account",
  "properties": {
    "account_number": {
      "type": "string"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "personal",
        "organization"
      ],
      "default": "personal"
    },
    "name": {
      "type": "string"
    },
    "owner_customer_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "closed"
      ],
      "default": "active"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "account_number",
    "account_type",
    "name",
    "owner_customer_id",
    "status",
    "revision"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}