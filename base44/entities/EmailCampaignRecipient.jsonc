{
  "name": "EmailCampaignRecipient",
  "type": "object",
  "properties": {
    "campaign_id": { "type": "string" },
    "customer_id": { "type": "string" },
    "auth_user_id": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "market_codes": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["pending", "sending", "sent", "failed", "cancelled"] },
    "attempt_count": { "type": "integer", "minimum": 0 },
    "dedupe_key": { "type": "string" },
    "provider_code": { "type": "string" },
    "sent_at": { "type": "string", "format": "date-time" }
  },
  "required": ["campaign_id", "customer_id", "auth_user_id", "email", "market_codes", "status", "attempt_count", "dedupe_key"],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}
