{
  "type": "object",
  "name": "HistoricalCandleSync",
  "properties": {
    "instrument_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "market_code": {
      "type": "string"
    },
    "provider_code": {
      "type": "string"
    },
    "interval": {
      "type": "string",
      "enum": [
        "1d"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "complete",
        "partial",
        "failed"
      ]
    },
    "requested_from": {
      "type": "string",
      "format": "date"
    },
    "requested_to": {
      "type": "string",
      "format": "date"
    },
    "earliest_bar_time": {
      "type": "string",
      "format": "date-time"
    },
    "latest_bar_time": {
      "type": "string",
      "format": "date-time"
    },
    "bar_count": {
      "type": "integer"
    },
    "year_chunk_count": {
      "type": "integer"
    },
    "checksum": {
      "type": "string"
    },
    "adjustment_mode": {
      "type": "string",
      "enum": [
        "provider_adjusted",
        "provider_ohlcv"
      ]
    },
    "provider_partial": {
      "type": "boolean"
    },
    "provider_first_trade_time": {
      "type": "string",
      "format": "date-time"
    },
    "coverage_verified": {
      "type": "boolean"
    },
    "source_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "last_attempt_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "failure_code": {
      "type": "string"
    },
    "failure_message": {
      "type": "string"
    }
  },
  "required": [
    "instrument_id",
    "symbol",
    "market_code",
    "provider_code",
    "interval",
    "status",
    "requested_from",
    "requested_to",
    "bar_count",
    "adjustment_mode",
    "source_id"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}