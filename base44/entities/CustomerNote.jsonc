{
  "type": "object",
  "name": "CustomerNote",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "author_user_id": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "maxLength": 1000
    },
    "visibility": {
      "type": "string",
      "enum": [
        "support",
        "admin",
        "owner"
      ]
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "customer_id",
    "author_user_id",
    "body",
    "visibility"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}