{
  "name": "DataSource",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "market_code": {
      "type": "string"
    },
    "quote_mode": {
      "type": "string",
      "enum": ["realtime", "delayed", "end_of_day", "disabled"]
    },
    "delay_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "public_enabled": {
      "type": "boolean",
      "default": false
    },
    "license_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "licensed",
        "official",
        "reference"
      ]
    },
    "license_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "restricted",
        "suspended",
        "expired"
      ]
    },
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "code",
    "name",
    "source_type",
    "license_status"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
