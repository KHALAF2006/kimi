{
  "type": "object",
  "name": "DataQualityIssue",
  "properties": {
    "instrument_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "issue_type": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "snapshot_version": {
      "type": "string"
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "occurrence_count": {
      "type": "integer",
      "minimum": 1
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "issue_type",
    "severity",
    "message",
    "status",
    "source_id"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}