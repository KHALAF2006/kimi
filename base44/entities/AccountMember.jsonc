{
  "name": "AccountMember",
  "type": "object",
  "properties": {
    "account_id": { "type": "string" },
    "customer_id": { "type": "string" },
    "member_type": { "type": "string", "enum": ["owner", "member"], "default": "member" },
    "status": { "type": "string", "enum": ["active", "invited", "suspended", "removed"], "default": "active" },
    "revision": { "type": "integer", "minimum": 1 }
  },
  "required": ["account_id", "customer_id", "member_type", "status", "revision"],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}
