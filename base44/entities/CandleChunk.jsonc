{
  "name": "CandleChunk",
  "type": "object",
  "properties": {
    "instrument_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "interval": {
      "type": "string",
      "enum": [
        "15m",
        "1h",
        "2h",
        "3h",
        "4h",
        "1d",
        "1wk",
        "1mo"
      ]
    },
    "chunk_key": {
      "type": "string"
    },
    "session_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "bars": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "open": {
            "type": "number"
          },
          "high": {
            "type": "number"
          },
          "low": {
            "type": "number"
          },
          "close": {
            "type": "number"
          },
          "volume": {
            "type": "number"
          }
        },
        "required": [
          "time",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ]
      }
    },
    "bar_count": {
      "type": "integer"
    },
    "checksum": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "snapshot_version": {
      "type": "string"
    },
    "provider_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "received_time": {
      "type": "string",
      "format": "date-time"
    },
    "quality_status": {
      "type": "string",
      "enum": [
        "verified",
        "stale",
        "quarantined"
      ]
    },
    "canonical_version": {
      "type": "string"
    },
    "is_final": {
      "type": "boolean",
      "default": false
    },
    "bucket_count": {
      "type": "integer"
    },
    "completeness_status": {
      "type": "string",
      "enum": [
        "complete",
        "degraded",
        "incomplete"
      ]
    },
    "is_historical_archive": {
      "type": "boolean",
      "default": false
    },
    "adjustment_mode": {
      "type": "string",
      "enum": ["none", "provider_adjusted"],
      "default": "none"
    },
    "history_from": {
      "type": "string",
      "format": "date"
    },
    "history_to": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "instrument_id",
    "symbol",
    "interval",
    "chunk_key",
    "start_time",
    "end_time",
    "bars",
    "bar_count",
    "checksum",
    "source_id",
    "quality_status"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
