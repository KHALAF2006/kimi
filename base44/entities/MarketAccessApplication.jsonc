{
  "name": "MarketAccessApplication",
  "type": "object",
  "properties": {
    "unique_reference": { "type": "string" },
    "customer_id": { "type": "string" },
    "auth_user_id": { "type": "string" },
    "trading_platform_id": { "type": "string" },
    "market_code": { "type": "string", "enum": ["SA_MAIN", "US_OPTIONS", "US_BENCHMARKS"] },
    "status": { "type": "string", "enum": ["referral_opened", "pending", "approved", "rejected", "cancelled"], "default": "referral_opened" },
    "full_name_snapshot": { "type": "string" },
    "email_snapshot": { "type": "string", "format": "email" },
    "phone_snapshot": { "type": "string" },
    "platform_name_ar_snapshot": { "type": "string" },
    "platform_name_en_snapshot": { "type": "string" },
    "referral_url_snapshot": { "type": "string" },
    "referral_clicked_at": { "type": "string", "format": "date-time" },
    "referral_click_count": { "type": "integer", "minimum": 0 },
    "customer_confirmed_at": { "type": "string", "format": "date-time" },
    "cooldown_until": { "type": "string", "format": "date-time" },
    "reviewed_by_user_id": { "type": "string" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "decision_reason": { "type": "string" },
    "approved_subscription_id": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 }
  },
  "required": ["unique_reference", "customer_id", "auth_user_id", "trading_platform_id", "market_code", "status", "full_name_snapshot", "email_snapshot", "phone_snapshot", "revision"],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}
