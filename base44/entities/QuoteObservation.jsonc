{
  "type": "object",
  "name": "QuoteObservation",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "snapshot_version": {
      "type": "string"
    },
    "market_code": {
      "type": "string"
    },
    "session_date": {
      "type": "string",
      "format": "date"
    },
    "instrument_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "last_price": {
      "type": "number"
    },
    "previous_close": {
      "type": "number"
    },
    "change_value": {
      "type": "number"
    },
    "change_percent": {
      "type": "number"
    },
    "open": {
      "type": "number"
    },
    "high": {
      "type": "number"
    },
    "low": {
      "type": "number"
    },
    "volume": {
      "type": "number"
    },
    "trade_count": {
      "type": "number"
    },
    "traded_value": {
      "type": "number"
    },
    "market_cap": {
      "type": "number"
    },
    "source_id": {
      "type": "string"
    },
    "provider_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "last_trade_time": {
      "type": "string",
      "format": "date-time"
    },
    "received_time": {
      "type": "string",
      "format": "date-time"
    },
    "delay_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "market_phase": {
      "type": "string",
      "enum": [
        "opening_auction",
        "continuous",
        "closing_auction",
        "trade_at_last",
        "closed"
      ]
    },
    "freshness_status": {
      "type": "string",
      "enum": [
        "fresh",
        "stale"
      ]
    },
    "quality_status": {
      "type": "string",
      "enum": [
        "verified",
        "stale",
        "quarantined"
      ]
    },
    "is_final": {
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "snapshot_version",
    "market_code",
    "session_date",
    "instrument_id",
    "symbol",
    "last_price",
    "previous_close",
    "source_id",
    "provider_as_of",
    "received_time",
    "delay_seconds",
    "market_phase",
    "freshness_status",
    "quality_status",
    "is_final"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}