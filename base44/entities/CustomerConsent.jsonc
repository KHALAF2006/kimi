{
  "type": "object",
  "name": "CustomerConsent",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "telegram",
        "whatsapp"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "granted",
        "withdrawn"
      ]
    },
    "source": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "withdrawn_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "customer_id",
    "channel",
    "purpose",
    "status",
    "source",
    "captured_at"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}