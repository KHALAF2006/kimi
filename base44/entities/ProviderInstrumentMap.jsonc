{
  "name": "ProviderInstrumentMap",
  "type": "object",
  "properties": {
    "instrument_id": { "type": "string" },
    "market_code": { "type": "string" },
    "provider_code": { "type": "string" },
    "provider_symbol": { "type": "string" },
    "quote_mode": { "type": "string", "enum": ["realtime", "delayed", "end_of_day"] },
    "delay_seconds": { "type": "integer", "minimum": 0 },
    "license_status": { "type": "string", "enum": ["pending", "approved", "suspended", "expired"] },
    "active": { "type": "boolean", "default": false }
  },
  "required": ["instrument_id", "market_code", "provider_code", "provider_symbol", "quote_mode", "delay_seconds", "license_status", "active"],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}
