{
  "name": "IngestionRun",
  "type": "object",
  "properties": {
    "run_type": {
      "type": "string"
    },
    "market_code": {
      "type": "string"
    },
    "slot_key": {
      "type": "string"
    },
    "slot_kind": {
      "type": "string",
      "enum": ["quarter_hour", "close_price", "session_final", "technical_projection", "historical_backfill", "manual"]
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time"
    },
    "provider_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot_version": {
      "type": "string"
    },
    "coverage_percent": {
      "type": "number"
    },
    "latency_ms": {
      "type": "integer"
    },
    "attempt_count": {
      "type": "integer"
    },
    "failure_code": {
      "type": "string"
    },
    "lease_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "promoted_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "total_records": {
      "type": "integer"
    },
    "success_count": {
      "type": "integer"
    },
    "failed_count": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "skipped",
        "success",
        "partial",
        "failed"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "run_type",
    "started_at",
    "total_records",
    "success_count",
    "failed_count",
    "status",
    "source_id"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
