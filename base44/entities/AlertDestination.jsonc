{
  "name": "AlertDestination",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "telegram",
        "whatsapp"
      ]
    },
    "label": {
      "type": "string"
    },
    "address_masked": {
      "type": "string"
    },
    "external_id": {
      "type": "string"
    },
    "secret_ref": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "customer_id",
    "channel",
    "label",
    "address_masked",
    "external_id",
    "secret_ref",
    "active"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}