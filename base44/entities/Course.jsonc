{
  "name": "Course",
  "type": "object",
  "properties": {
    "code": { "type": "string" },
    "title_ar": { "type": "string" },
    "title_en": { "type": "string" },
    "description_ar": { "type": "string" },
    "description_en": { "type": "string" },
    "cover_file_uri": { "type": "string" },
    "visibility": { "type": "string", "enum": ["public", "market"], "default": "public" },
    "storage_mode": { "type": "string", "enum": ["base44_private"], "default": "base44_private" },
    "market_code": { "type": "string", "enum": ["SA_MAIN", "US_OPTIONS", "US_BENCHMARKS"] },
    "status": { "type": "string", "enum": ["draft", "published", "archived"], "default": "draft" },
    "display_order": { "type": "integer", "minimum": 0 },
    "revision": { "type": "integer", "minimum": 1 }
  },
  "required": ["code", "title_ar", "title_en", "visibility", "storage_mode", "status", "display_order", "revision"],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}
