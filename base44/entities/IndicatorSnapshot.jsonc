{
  "type": "object",
  "name": "IndicatorSnapshot",
  "properties": {
    "instrument_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "indicator_key": {
      "type": "string"
    },
    "timeframe": {
      "type": "string"
    },
    "values": {
      "type": "object"
    },
    "source_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "calculated_at": {
      "type": "string",
      "format": "date-time"
    },
    "formula_version": {
      "type": "string",
      "default": "momentum-zones-v1"
    }
  },
  "required": [
    "instrument_id",
    "symbol",
    "indicator_key",
    "timeframe",
    "values",
    "source_as_of",
    "calculated_at",
    "formula_version"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}