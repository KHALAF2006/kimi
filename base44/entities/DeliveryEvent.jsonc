{
  "name": "DeliveryEvent",
  "type": "object",
  "properties": {
    "alert_rule_id": {
      "type": "string"
    },
    "destination_id": {
      "type": "string"
    },
    "dedupe_key": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "telegram",
        "whatsapp",
        "email"
      ]
    },
    "market_code": { "type": "string" },
    "trigger_price": { "type": "number" },
    "trigger_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "trigger_condition": { "type": "string" },
    "trigger_threshold": { "type": "number" },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "retry"
      ]
    },
    "attempt_count": {
      "type": "integer"
    },
    "recipient_cursor": { "type": "integer", "minimum": 0 },
    "recipient_count": { "type": "integer", "minimum": 0 },
    "provider_code": {
      "type": "string"
    },
    "next_attempt_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "alert_rule_id",
    "destination_id",
    "dedupe_key",
    "channel",
    "status",
    "attempt_count"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
