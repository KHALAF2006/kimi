{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "us_benchmarks_historical_bootstrap",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "backfill_us_benchmarks_history": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "usBenchmarksMarketIngestion",
            "args": {
              "market_code": "US_BENCHMARKS",
              "action": "history",
              "batch_size": 6,
              "source": "scheduled_history"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u062a\u0647\u064a\u0626\u0629 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u064a\u0648\u0645\u064a",
            "description": "\u062f\u0641\u0639\u0629 \u064a\u0648\u0645\u064a\u0629 \u0645\u0646 \u0627\u0644\u0623\u0631\u0634\u064a\u0641"
          }
        }
      }
    ]
  },
  "description": "\u0625\u0637\u0644\u0627\u0642 \u0645\u0631\u062d\u0644\u064a \u064a\u0645\u0644\u0623 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u064a\u0648\u0645\u064a \u0627\u0644\u0643\u0627\u0645\u0644 \u0644\u0644\u0645\u0624\u0634\u0631\u0627\u062a \u0648\u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642 \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a\u0629 \u0639\u0644\u0649 \u062f\u0641\u0639\u0627\u062a \u0648\u064a\u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u0645\u0643\u062a\u0645\u0644.",
  "name": "\u0627\u0644\u0645\u0624\u0634\u0631\u0627\u062a \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a\u0629 \u2014 \u062a\u0647\u064a\u0626\u0629 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 2 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}