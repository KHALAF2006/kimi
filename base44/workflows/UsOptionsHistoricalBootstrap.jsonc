    "config": {
      "trigger_type": "scheduled", "events": [], "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *", "one_time_date": null,
      "timezone": "America/New_York", "interval_value": null, "interval_unit": null,
      "interval_anchor": null, "ends_type": "after", "ends_on_date": null, "ends_after_count": 12
    }
  }
