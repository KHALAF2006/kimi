{
  "definition": {
    "document": { "dsl": "1.0.0", "name": "us_options_signals_daily", "version": "1.0", "namespace": "base44" },
    "do": [{
      "refresh_us_options_signals": {
        "call": "invoke_backend_function",
        "with": { "function_name": "usOptionsSignalRefresh", "args": { "market_code": "US_OPTIONS", "source": "daily_session_projection" } },
        "then": "end"
      }
    }]
  },
  "description": "تحديث الشموع اليومية والأسبوعية والشهرية والإشارات بعد إغلاق نيويورك.",
  "name": "سوق الخيارات — الشموع والإشارات اليومية",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled", "events": [], "schedule_mode": "recurring",
      "cron_expression": "0 18 * * 1-5", "one_time_date": null,
      "timezone": "America/New_York", "interval_value": null, "interval_unit": null,
      "interval_anchor": null, "ends_type": "never", "ends_on_date": null, "ends_after_count": null
    }
  }
}
