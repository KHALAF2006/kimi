{
  "name": "تحديث السوق — الدورات الساعية",
  "description": "يجلب جميع شموع 15 دقيقة الجديدة المكتملة مرة كل ساعة، مع الاحتفاظ بالسجل المحفوظ وعدم إعادة طلبه كاملًا.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "18 11-14 * * 0-4",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "market_quarter_cycles",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh_market_quarter": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "marketIngestion",
            "args": {
              "slot_kind": "quarter_hour",
              "source": "experimental_t15"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u062c\u0644\u0628 \u0634\u0645\u0648\u0639 \u0627\u0644\u0631\u0628\u0639",
            "description": "\u0628\u0639\u062f \u0627\u0643\u062a\u0645\u0627\u0644 \u0646\u0634\u0631 \u0627\u0644\u0645\u0635\u062f\u0631"
          }
        }
      }
    ]
  }
}
