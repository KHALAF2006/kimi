          "call": "invoke_backend_function",
          "with": {
            "function_name": "marketIngestion",
            "args": {
              "slot_kind": "quarter_hour",
              "source": "experimental_t15"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u062c\u0644\u0628 \u0634\u0645\u0648\u0639 \u0627\u0644\u0631\u0628\u0639",
            "description": "\u0628\u0639\u062f \u0627\u0643\u062a\u0645\u0627\u0644 \u0646\u0634\u0631 \u0627\u0644\u0645\u0635\u062f\u0631"
          }
        }
      }
    ]
  }
