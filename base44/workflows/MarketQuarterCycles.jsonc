{
  "name": "\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0633\u0648\u0642 \u2014 \u062f\u0648\u0631\u0627\u062a \u0627\u0644\u0631\u0628\u0639 \u0633\u0627\u0639\u0629",
  "description": "\u064a\u062c\u0644\u0628 \u0627\u0644\u0634\u0645\u0648\u0639 \u0627\u0644\u0645\u062a\u0623\u062e\u0631\u0629 \u0628\u0639\u062f \u062b\u0644\u0627\u062b \u062f\u0642\u0627\u0626\u0642 \u0645\u0646 \u0627\u0643\u062a\u0645\u0627\u0644 \u0646\u0634\u0631 \u0643\u0644 \u0631\u0628\u0639 \u0633\u0627\u0639\u0629 \u0644\u062a\u062c\u0646\u0628 \u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u062f\u0648\u0631\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "18,33,48 10-14 * * 0-4",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "market_quarter_cycles",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
