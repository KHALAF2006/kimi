{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "market_quarter_cycles",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh_market_quarter": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "marketIngestion",
            "args": {
              "slot_kind": "quarter_hour",
              "source": "experimental_t15"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "description": "دورات T+15 عند 10:15 و10:30 و10:45، ثم الدقائق 15 و30 و45 حتى 14:45.",
  "name": "تحديث السوق — دورات الربع ساعة",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "15,30,45 10-14 * * 0-4",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}
