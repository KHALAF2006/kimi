{
  "name": "تحديث السوق — أول دورة ساعية",
  "description": "يبدأ تحديث السوق السعودي الساعة 10:18 ويجلب جميع شموع 15 دقيقة المكتملة المتاحة من آخر مؤشر زمني محفوظ.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "18 10 * * 0-4",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "market_hourly_boundaries",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh_market_hour_boundary": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "marketIngestion",
            "args": {
              "slot_kind": "quarter_hour",
              "source": "experimental_t15"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u062c\u0644\u0628 \u0634\u0645\u0639\u0629 \u0631\u0623\u0633 \u0627\u0644\u0633\u0627\u0639\u0629",
            "description": "\u0628\u0639\u062f \u0627\u0643\u062a\u0645\u0627\u0644 \u0646\u0634\u0631 \u0627\u0644\u0645\u0635\u062f\u0631"
          }
        }
      }
    ]
  }
}
