{
  "definition": {
    "document": { "dsl": "1.0.0", "name": "delivery_worker_every_fifteen_minutes", "version": "1.1", "namespace": "base44" },
    "do": [{
      "process_delivery_queue": {
        "call": "invoke_backend_function",
        "with": { "function_name": "deliveryWorker", "args": { "action": "scheduled", "dry_run": true } },
        "then": "end"
      }
    }]
  },
  "description": "يفحص طابور قنوات الإرسال المركزية دون إرسال حتى يعتمد المالك تفعيل المعالجة الفعلية.",
  "name": "معالجة قنوات الإرسال المركزية",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled", "events": [], "schedule_mode": "recurring", "cron_expression": "0 10-23 * * 0-5",
      "one_time_date": null, "timezone": "Asia/Riyadh", "interval_value": null, "interval_unit": null,
      "interval_anchor": null, "ends_type": "never", "ends_on_date": null, "ends_after_count": null
    }
  }
}
