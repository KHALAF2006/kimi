{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "delivery_worker_every_fifteen_minutes",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "process_delivery_queue": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "deliveryWorker",
            "args": {
              "action": "scheduled",
              "dry_run": false
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "description": "\u064a\u0639\u0627\u0644\u062c \u0637\u0627\u0628\u0648\u0631 \u0642\u0646\u0648\u0627\u062a \u0627\u0644\u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0645\u0631\u0643\u0632\u064a\u0629 \u0643\u0644 \u062e\u0645\u0633 \u0639\u0634\u0631\u0629 \u062f\u0642\u064a\u0642\u0629\u060c \u0645\u0639 \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0648\u0645\u0646\u0639 \u0628\u0642\u0627\u0621 \u0627\u0644\u062d\u0627\u0644\u0627\u062a \u0627\u0644\u0645\u0639\u0644\u0642\u0629.",
  "name": "\u0645\u0639\u0627\u0644\u062c\u0629 \u0642\u0646\u0648\u0627\u062a \u0627\u0644\u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0645\u0631\u0643\u0632\u064a\u0629",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 10-23 * * 0-5",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}