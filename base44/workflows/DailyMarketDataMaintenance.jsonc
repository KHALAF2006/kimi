{
  "name": "\u0635\u064a\u0627\u0646\u0629 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0633\u0648\u0642 \u0627\u0644\u064a\u0648\u0645\u064a\u0629",
  "description": "\u064a\u0637\u0628\u0642 \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u0642\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u062e\u0627\u0645 \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0648\u064a\u0635\u0644\u062d \u0647\u0648\u064a\u0629 \u0627\u0644\u0633\u0648\u0642 \u0641\u064a \u0627\u0644\u0633\u062c\u0644\u0627\u062a \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0639\u0644\u0649 \u062f\u0641\u0639\u0627\u062a \u0645\u062d\u062f\u0648\u062f\u0629\u060c \u0645\u0639 \u0633\u062c\u0644 \u062a\u062f\u0642\u064a\u0642 \u0644\u0644\u0645\u0627\u0644\u0643.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 2 * * *",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_market_data_maintenance",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_market_data_maintenance": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "operationsQuality",
            "args": {
              "action": "scheduled_maintenance"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0642\u0631\u0627\u0621\u0627\u062a \u0648\u0625\u0635\u0644\u0627\u062d \u0647\u0648\u064a\u0629 \u0627\u0644\u0633\u0648\u0642",
            "description": "\u0635\u064a\u0627\u0646\u0629 \u0645\u0627\u0644\u0643-\u0641\u0642\u0637 \u0628\u0639\u062f \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0623\u0633\u0648\u0627\u0642"
          }
        }
      }
    ]
  }
}