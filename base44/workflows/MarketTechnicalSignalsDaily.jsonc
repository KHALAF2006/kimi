{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "market_technical_signals_daily",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      { "refresh_signals_batch_1": { "call": "invoke_backend_function", "with": { "function_name": "marketSignalRefresh", "args": { "source": "daily_session_projection", "mode": "projection_batch", "batch_index": 0, "batch_count": 6 } } } },
      { "refresh_signals_batch_2": { "call": "invoke_backend_function", "with": { "function_name": "marketSignalRefresh", "args": { "source": "daily_session_projection", "mode": "projection_batch", "batch_index": 1, "batch_count": 6 } } } },
      { "refresh_signals_batch_3": { "call": "invoke_backend_function", "with": { "function_name": "marketSignalRefresh", "args": { "source": "daily_session_projection", "mode": "projection_batch", "batch_index": 2, "batch_count": 6 } } } },
      { "refresh_signals_batch_4": { "call": "invoke_backend_function", "with": { "function_name": "marketSignalRefresh", "args": { "source": "daily_session_projection", "mode": "projection_batch", "batch_index": 3, "batch_count": 6 } } } },
      { "refresh_signals_batch_5": { "call": "invoke_backend_function", "with": { "function_name": "marketSignalRefresh", "args": { "source": "daily_session_projection", "mode": "projection_batch", "batch_index": 4, "batch_count": 6 } } } },
      { "refresh_signals_batch_6": { "call": "invoke_backend_function", "with": { "function_name": "marketSignalRefresh", "args": { "source": "daily_session_projection", "mode": "projection_batch", "batch_index": 5, "batch_count": 6 } } } },
      { "finalize_daily_candles_and_signals": { "call": "invoke_backend_function", "with": { "function_name": "marketSignalRefresh", "args": { "source": "daily_session_projection", "mode": "projection_finalize", "batch_count": 6 } }, "then": "end" } }
    ]
  },
  "description": "تثبيت الشمعة اليومية بعد الإغلاق وتحديث الشموع الأسبوعية والشهرية وإشارات البحث.",
  "name": "تثبيت الشموع والإشارات اليومية",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "52 15 * * 0-4",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}
