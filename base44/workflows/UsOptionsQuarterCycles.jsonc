{
  "name": "سوق الخيارات — التحديث الساعي — الدفعة 1",
  "description": "تجلب الدفعة الأولى كل ساعة بيانات 5 دقائق الجديدة فقط، ثم تحفظ منها شموع 15 دقيقة المكتملة دون إعادة التاريخ المحفوظ.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "20 10-16 * * 1-5",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "us_options_quarter_cycles",
      "version": "1.2",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh_us_options_quarter": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "usOptionsMarketIngestion",
            "args": {
              "market_code": "US_OPTIONS",
              "source": "scheduled_t15",
              "batch_index": 0,
              "batch_count": 2
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u2014 \u0627\u0644\u062f\u0641\u0639\u0629 1",
            "description": "\u0628\u0646\u0627\u0621 \u0634\u0645\u0648\u0639 15 \u062f\u0642\u064a\u0642\u0629 \u0645\u0646 \u0623\u062c\u0632\u0627\u0621 5 \u062f\u0642\u0627\u0626\u0642"
          }
        }
      }
    ]
  }
}
