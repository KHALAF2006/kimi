            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u062c\u0644\u0628 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0633\u0648\u0642",
            "description": "\u062f\u0648\u0631\u0629 \u0645\u062c\u062f\u0648\u0644\u0629 \u0645\u062d\u062c\u0648\u0628\u0629 \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0627\u064b"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
