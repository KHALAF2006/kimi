{
  "name": "\u0627\u0644\u0645\u0624\u0634\u0631\u0627\u062a \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a\u0629 \u2014 \u0623\u0631\u0634\u064a\u0641 \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0644\u062d\u0638\u064a",
  "description": "\u064a\u0639\u064a\u062f \u0628\u0646\u0627\u0621 \u0634\u0647\u0631 \u062a\u062f\u0627\u0648\u0644 \u0643\u0627\u0645\u0644 \u0645\u0646 \u0634\u0645\u0648\u0639 5 \u062f\u0642\u0627\u0626\u0642 \u0648\u064a\u062e\u0632\u0646\u0647 \u0643\u0634\u0645\u0648\u0639 15 \u062f\u0642\u064a\u0642\u0629 \u0628\u0639\u062f \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0633\u0648\u0642.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 18 * * 1-5",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "us_benchmarks_intraday_history",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh_intraday_history": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "usBenchmarksMarketIngestion",
            "args": {
              "market_code": "US_BENCHMARKS",
              "action": "intraday_history",
              "batch_size": 8,
              "source": "scheduled_intraday_history"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u062a\u062d\u062f\u064a\u062b \u0623\u0631\u0634\u064a\u0641 \u0627\u0644\u0634\u0647\u0631",
            "description": "\u0634\u0645\u0648\u0639 15 \u062f\u0642\u064a\u0642\u0629 \u0644\u0643\u0644 \u0627\u0644\u0623\u062f\u0648\u0627\u062a"
          }
        }
      }
    ]
  }
}
