{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "company_intelligence_daily",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh_company_intelligence": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "companyIntelligence",
            "args": { "mode": "daily" }
