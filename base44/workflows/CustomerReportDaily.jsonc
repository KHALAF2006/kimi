{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "customer_report_daily",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "update_customer_report": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "customerReport",
            "args": { "action": "scheduled" }
          },
          "then": "end"
        }
      }
    ]
  },
  "description": "يحدّث تقرير العملاء الخاص بالمالك يومياً، مع صفحة شاملة وصفحة مستقلة لكل يوم.",
  "name": "تحديث تقرير العملاء اليومي",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "55 23 * * *",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}
