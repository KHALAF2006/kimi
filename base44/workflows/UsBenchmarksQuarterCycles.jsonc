{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "us_benchmarks_quarter_cycles",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh_us_benchmarks": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "usBenchmarksMarketIngestion",
            "args": {
              "market_code": "US_BENCHMARKS",
              "source": "scheduled_t15"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0645\u0624\u0634\u0631\u0627\u062a \u0648\u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642",
            "description": "\u0623\u0633\u0639\u0627\u0631 \u0648\u0634\u0645\u0648\u0639 15 \u062f\u0642\u064a\u0642\u0629"
          }
        }
      }
    ]
  },
  "description": "تحديث ساعي لبيانات المؤشرات والصناديق الأمريكية الجديدة، مع حفظ شموع 15 دقيقة المكتملة وعدم إعادة التاريخ المحفوظ.",
  "name": "المؤشرات الأمريكية — التحديث الساعي",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "20 10-16 * * 1-5",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}
