  "description": "\u064a\u062c\u0644\u0628 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0633\u0648\u0642 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0627\u0644\u0645\u0631\u062c\u0639\u064a\u0629 \u0627\u0644\u0645\u062a\u0623\u062e\u0631\u0629 \u062e\u0644\u0627\u0644 \u062c\u0644\u0633\u0629 \u0627\u0644\u062a\u062f\u0627\u0648\u0644.",
  "name": "\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0633\u0648\u0642 \u0643\u0644 \u0631\u0628\u0639 \u0633\u0627\u0639\u0629",
  "trigger": {
