{
  "name": "\u062a\u062d\u062f\u064a\u062b \u0634\u0627\u0631\u062a\u0627\u062a \u0627\u0644\u0642\u0637\u0627\u0639\u0627\u062a \u0627\u0644\u0645\u0631\u0643\u0632\u064a\u0629",
  "description": "\u064a\u0628\u0646\u064a \u0634\u0627\u0631\u062a \u0643\u0644 \u0642\u0637\u0627\u0639 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u064a \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0648\u064a\u062d\u0641\u0638 \u062c\u0645\u064a\u0639 \u0641\u0648\u0627\u0635\u0644\u0647 \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0644\u062a\u0642\u0631\u0623\u0647 \u062c\u0645\u064a\u0639 \u062d\u0633\u0627\u0628\u0627\u062a \u0627\u0644\u0633\u0648\u0642 \u0645\u0628\u0627\u0634\u0631\u0629 \u062f\u0648\u0646 \u0625\u0639\u0627\u062f\u0629 \u062a\u062c\u0645\u064a\u0639 \u0634\u0631\u0643\u0627\u062a \u0627\u0644\u0642\u0637\u0627\u0639 \u0639\u0646\u062f \u0627\u0644\u0641\u062a\u062d.",
  "trigger": {
