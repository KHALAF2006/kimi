  "description": "\u064a\u0641\u062d\u0635 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u064a\u0648\u0645\u064a \u0627\u0644\u0627\u062b\u0646\u064a\u0646 \u0648\u0627\u0644\u062e\u0645\u064a\u0633 \u0628\u0639\u062f \u0627\u0644\u0625\u063a\u0644\u0627\u0642 \u0648\u064a\u062d\u062f\u0651\u062b \u0627\u0644\u0642\u064a\u0645 \u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0629 \u0641\u0642\u0637.",
  "name": "\u0641\u062d\u0635 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0645\u0631\u062a\u064a\u0646 \u0623\u0633\u0628\u0648\u0639\u064a\u064b\u0627",
  "trigger": {
